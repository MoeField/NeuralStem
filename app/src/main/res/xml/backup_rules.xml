<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11- 的 Auto Backup 规则。
  模型（sherpa/spleeter4/demucs/uvr）与分离/PCM/波形缓存都很大，且可由用户重新下载；
  歌单里含本地媒体 URI，不应上传云端。只保留小的设置类数据。
-->
<full-backup-content>
    <exclude domain="file" path="sherpa" />
    <exclude domain="file" path="spleeter4" />
    <exclude domain="file" path="demucs" />
    <exclude domain="file" path="uvr" />
    <exclude domain="file" path="stems-cache" />
    <exclude domain="file" path="pcm-cache" />
    <exclude domain="file" path="avs3-pcm-cache" />
    <exclude domain="file" path="waveform-cache" />
    <exclude domain="file" path="playlists.json" />
    <exclude domain="external" path="uvr" />
    <exclude domain="external" path="NCM" />
</full-backup-content>
