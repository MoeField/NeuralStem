<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- V2(guide N4):后台播放前台服务权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- API 33+ 媒体通知需要运行时授权 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:largeHeap="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NeuralStem">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.NeuralStem"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Task 0b Spike: 音轨分离技术验证页(独立于主 UI,验证后可移除) -->
        <activity
            android:name=".spike.SpikeActivity"
            android:exported="true"
            android:label="Spike 分离验证">
        </activity>

        <!-- V2(guide N4):后台播放前台服务(MediaSessionService)
             MediaSessionService 会在播放时自动升为前台服务并发布媒体通知,
             切后台/锁屏仍继续播放。foregroundServiceType=mediaPlayback 是 API 34+ 强制要求。 -->
        <service
            android:name=".player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- ★T0:测试命令入口(仅 debug 生效;onStartCommand 以 BuildConfig.DEBUG 守卫)。
             用 am start-service 而非 broadcast(vivo/Android16 静默丢弃 manifest 广播,
             同类于已知坑52;service 不受广播限制且不重建 Activity)。
             用法见 devtools/TestCommandBus.helpText -->
        <service
            android:name=".devtools.TestCommandService"
            android:exported="true" />

        <!-- ★测试面板（debug 工具）：按钮 + 屏上日志，避开 vivo 吞 logcat。
             adb shell am start (component=pub.miku.neuralstem/.devtools.TestPanelActivity) -->
        <activity
            android:name=".devtools.TestPanelActivity"
            android:exported="true"
            android:label="测试面板" />
    </application>

</manifest>