<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- V2(guide N4):后台播放前台服务权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- ★G-4:分离任务前台服务(dataSync)权限 —— 避免后台被降频 ~2× -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- API 33+ 媒体通知需要运行时授权 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      ★模型一键下载：需联网从 HuggingFace / hf-mirror 拉模型。
      此前本项目完全离线，从未申请过网络权限 —— 缺了会 DNS 解析失败
      （GaiException EAI_NODATA + EPERM，极易误判为“网络不通”）。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      ★NCM 导入后读取需要存储权限（2026-10-25 真机踩到）。

      Shizuku 把 .ncm 从网易云私有目录复制到 `/sdcard/Music/NCM/`（公共目录），
      但**公共目录不等于免权限**：App 仍需 READ 权限才能读里面的文件。
      实测：`File.exists()=true, length()=14168127, canRead()=false` →
      打开时报 `EACCES (Permission denied)`。

      - Android 13+（API 33）：`READ_MEDIA_AUDIO`（运行时授权）
      - Android 12 及以下：`READ_EXTERNAL_STORAGE`（maxSdkVersion=32）
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
      ★NCM 导入（Shizuku）：仅 `-Pwith_ncm=true` 构建才会真正引用这些库。

      `tools:overrideLibrary` 的用途：Shizuku 的 AAR 声明 minSdk=24，
      而本项目 minSdk=23。这个 override 让清单合并通过。
      **安全性**：NcmImporter 的全部入口都在 NCM 面板（with_ncm 构建）里，
      Android 6（API 23）用户即使误入也会在调用 Shizuku 时安全失败（功能不支持），
      不影响播放/分离等主线功能。
    -->
    <uses-sdk tools:overrideLibrary="rikka.shizuku.api,rikka.shizuku.provider" />

    <application
        android:largeHeap="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NeuralStem">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.NeuralStem"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Task 0b Spike: 音轨分离技术验证页(独立于主 UI,验证后可移除) -->
        <activity
            android:name=".spike.SpikeActivity"
            android:exported="true"
            android:label="Spike 分离验证">
        </activity>

        <!-- V2(guide N4):后台播放前台服务(MediaSessionService)
             MediaSessionService 会在播放时自动升为前台服务并发布媒体通知,
             切后台/锁屏仍继续播放。foregroundServiceType=mediaPlayback 是 API 34+ 强制要求。 -->
        <!-- ★G-4:分离前台服务（前台窗口仅覆盖“分离进行中”，结束即自停）。
             播放用的 PlaybackService(mediaPlayback) 独立存在，互不影响。 -->
        <service
            android:name=".spike.SeparationService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- ★T0:测试命令入口(仅 debug 生效;onStartCommand 以 BuildConfig.DEBUG 守卫)。
             用 am start-service 而非 broadcast(vivo/Android16 静默丢弃 manifest 广播,
             同类于已知坑52;service 不受广播限制且不重建 Activity)。
             用法见 devtools/TestCommandBus.helpText -->
        <service
            android:name=".devtools.TestCommandService"
            android:exported="true" />

        <!-- ★测试面板（debug 工具）：按钮 + 屏上日志，避开 vivo 吞 logcat。
             adb shell am start (component=pub.miku.neuralstem/.devtools.TestPanelActivity) -->
        <activity
            android:name=".devtools.TestPanelActivity"
            android:exported="true"
            android:label="测试面板" />

        <!--
          ★Shizuku Provider（NCM 导入用）。

          ## 为何必须有它
          Shizuku API 靠这个 provider 完成 **binder 初始化**：
          `Shizuku.pingBinder()` / `checkSelfPermission()` / `newProcess()` 全部依赖它。
          没有声明时，`pingBinder()` 恒为 false → 表现为“Shizuku 没运行”，
          但实际进程在跑（第一次实测就踩了这坑）。

          ## 字段说明（照官方 demo）
          - `authorities = ${applicationId}.shizuku`：必须是这个格式
          - `exported = true` + `permission = INTERACT_ACROSS_USERS_FULL`：
            Shizuku App 需要跨用户访问它，缺了权限声明会 binder 失败

          ★★ 这个 provider 由 `android:enabled="${shizukuProviderEnabled}"` 控制
        （2026-10-26 发布事故修正）。

        ## 曾经的错误认识
        这里原本写着“默认构建带着也无害，因为无代码引用” —— **错的**。
        `ContentProvider` 是 **Application 进程启动时由系统实例化的**，
        与“有没有代码引用”完全无关。而 Shizuku 依赖只在 `withNcm` 时才加入，
        于是公开版的启动流程变成：
        ```
        FATAL EXCEPTION: main
        Unable to get provider rikka.shizuku.ShizukuProvider:
          java.lang.ClassNotFoundException: Didn't find class "rikka.shizuku.ShizukuProvider"
        ```
        → **公开版一启动就崩，装上去根本打不开**。

        ## 现在怎么做
        留在本文清单里，但 `android:enabled` 用 manifest placeholder 控制：
        - `with_ncm=true` → `true`（正常可用）
        - 否则 → `false`（系统不实例化 → 不会 ClassNotFound）

        为何不拆到 `src/ncm/AndroidManifest.xml`：AGP 的 manifest 是**单文件**，
        拆开要维护两份且容易不同步；用 enabled 开关只改一行。
    -->
    <provider
        android:name="rikka.shizuku.ShizukuProvider"
        android:authorities="${applicationId}.shizuku"
        android:enabled="${shizukuProviderEnabled}"
        android:exported="true"
        android:multiprocess="false"
        android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

</manifest>